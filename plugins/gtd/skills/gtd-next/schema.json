{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {"type": "string", "pattern": "^@", "description": "e.g. @computer"},
    "minutes": {"type": "integer", "minimum": 1, "description": "time available"},
    "energy": {"type": "string", "enum": ["low", "med", "high"]}
  }
}
