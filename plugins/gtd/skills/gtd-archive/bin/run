#!/usr/bin/env python3
"""gtd-archive skill. Moves a done/dropped action out of current/waiting/maybe
into archive/YYYY-MM.md, so it leaves the active views without being lost.
Dependency-free (only /usr under bwrap)."""

from __future__ import annotations

import json
import os
import re
import sys
from datetime import date
from pathlib import Path

SEARCH_DIRS = ("current", "waiting", "maybe")


def find_line(vault: Path, item_id: str):
    for d in SEARCH_DIRS:
        base = vault / d
        if not base.is_dir():
            continue
        for f in sorted(base.rglob("*.md")):
            lines = f.read_text(encoding="utf-8").split("\n")
            for i, line in enumerate(lines):
                if f"id:{item_id}" in line:
                    return d, f, i, lines, line
    return None


def main() -> int:
    params = json.loads(sys.stdin.read())
    vault = Path(os.environ["HUBIDUBIOS_VAULT"])
    item_id = params["id"]
    found = find_line(vault, item_id)
    if not found:
        print(json.dumps({"error": "item not found in current/waiting/maybe"}))
        return 1
    state, f, idx, lines, line = found

    del lines[idx]
    f.write_text("\n".join(lines), encoding="utf-8")

    done = params.get("done_date") or date.today().isoformat()
    archived = re.sub(r"- \[[ xX]\]", "- [x]", line, count=1)
    if "-->" in archived:
        archived = archived.replace("-->", f"done:{done} from:{state} -->", 1)
    else:
        archived += f"  <!-- done:{done} from:{state} -->"

    arch = vault / "archive" / f"{done[:7]}.md"
    arch.parent.mkdir(parents=True, exist_ok=True)
    content = ""
    if arch.exists():
        content = arch.read_text(encoding="utf-8")
        if content and not content.endswith("\n"):
            content += "\n"
    arch.write_text(content + archived + "\n", encoding="utf-8")
    print(json.dumps({"archived": item_id, "from": state,
                      "file": str(arch.relative_to(vault))}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
