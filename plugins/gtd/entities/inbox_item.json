{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inbox_item",
  "type": "object",
  "required": [
    "id",
    "updated",
    "type",
    "text"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^i_[a-z2-7]+$"
    },
    "updated": {
      "type": "string"
    },
    "type": {
      "const": "inbox_item"
    },
    "text": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "text",
        "image",
        "audio",
        "document"
      ]
    },
    "media": {
      "type": [
        "string",
        "null"
      ]
    },
    "media_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "media_mime": {
      "type": [
        "string",
        "null"
      ]
    },
    "media_bytes": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "due": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\\\d{4}-\\\\d{2}-\\\\d{2}$"
    }
  }
}
