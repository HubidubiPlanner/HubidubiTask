{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "waiting_for",
  "type": "object",
  "required": ["id", "updated", "type", "text"],
  "properties": {
    "id": {"type": "string", "pattern": "^t_[a-z2-7]+$"},
    "updated": {"type": "string"},
    "type": {"const": "waiting_for"},
    "text": {"type": "string"},
    "done": {"type": "boolean"},
    "who": {"type": ["string", "null"], "description": "person delegated to"},
    "due": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "done_date": {"type": ["string", "null"]}
  }
}
