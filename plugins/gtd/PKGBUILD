# Maintainer: hubidubios
# The GTD workflow plugin supersedes the tasks and inbox extraction plugins —
# it owns the richer entity model — so it conflicts with them.
pkgname=hubidubios-plugin-gtd
pkgver=1.0.0
pkgrel=1
pkgdesc="hubidubios plugin: Getting Things Done workflow"
arch=('any')
url="https://gitlab.local/hubidubios"
license=('MIT')
depends=('hubidubios-plugin-host')
conflicts=('hubidubios-plugin-tasks' 'hubidubios-plugin-inbox')
install=hubidubios-plugin.install
source=()

package() {
  local dest="$pkgdir/usr/share/hubidubios/plugins/gtd"
  local src="$startdir"
  install -d "$dest"
  cp -r "$src/PLUGIN.md" "$src/entities" "$src/skills" "$src/views" "$dest/"
  chmod 755 "$dest"/skills/*/bin/run
}
