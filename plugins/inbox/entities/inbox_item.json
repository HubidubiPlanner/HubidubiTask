{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inbox_item",
  "type": "object",
  "required": ["id", "updated", "type", "text"],
  "properties": {
    "id": {"type": "string", "pattern": "^i_[a-z2-7]+$"},
    "updated": {"type": "string"},
    "type": {"const": "inbox_item"},
    "text": {"type": "string"},
    "time": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
