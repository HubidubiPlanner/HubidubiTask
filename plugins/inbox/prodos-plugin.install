# pacman install scriptlet: keep the vault entity registry and index in sync
# with what is installed. Runs as the invoking user's session is not
# guaranteed here, so refresh is best-effort and also run on first login.

post_install() {
  _refresh
}

post_upgrade() {
  _refresh
}

post_remove() {
  _refresh
}

_refresh() {
  # Refresh for each real user with a vault. On a single-user workstation
  # this is the owner; the || true keeps pacman from failing on a headless box.
  if command -v prodos-plugins >/dev/null 2>&1; then
    su - "$(stat -c %U /home/* 2>/dev/null | head -1)" -c \
      'prodos-plugins refresh' >/dev/null 2>&1 || true
  fi
}
