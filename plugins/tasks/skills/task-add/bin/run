#!/usr/bin/env python3
"""task-add skill. JSON stdin -> JSON stdout. Dependency-free: runs under
bwrap with only /usr visible and only vault:tasks writable."""

import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path


def new_id() -> str:
    alphabet = "abcdefghijklmnopqrstuvwxyz234567"
    return "t_" + "".join(alphabet[b & 31] for b in os.urandom(8))


def main() -> int:
    params = json.load(sys.stdin)
    text = str(params["text"]).strip()
    if not text:
        print(json.dumps({"error": "empty task text"}))
        return 1
    project = params.get("project") or "inbox"
    vault = Path(os.environ["HUBIDUBIOS_VAULT"])
    path = vault / "tasks" / f"{project}.md"

    md = [f"id:{new_id()}"]
    if params.get("due"):
        md.append(f"due:{params['due']}")
    if params.get("ctx"):
        md.append(f"ctx:{params['ctx']}")
    updated = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    md.append(f"updated:{updated}")
    line = f"- [ ] {text}  <!-- {' '.join(md)} -->"

    if path.exists():
        content = path.read_text(encoding="utf-8")
        if content and not content.endswith("\n"):
            content += "\n"
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        content = f"---\nproject: {project}\n---\n\n"
    path.write_text(content + line + "\n", encoding="utf-8")

    print(json.dumps({"id": md[0].split(":", 1)[1],
                      "file": f"tasks/{project}.md"}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
