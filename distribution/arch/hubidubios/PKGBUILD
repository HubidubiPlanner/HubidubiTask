# Maintainer: hubidubios
# The HubidubiOS desktop app for Linux (Omarchy and other Arch systems).
# Built from the Compose app image that distribution/arch/build.sh makes in
# an x86_64 container; it carries its own Java runtime.
pkgname=hubidubios
pkgver=1.6.0
pkgrel=1
pkgdesc="HubidubiOS: tasks, notes and feeds, synced with your phone"
arch=('x86_64')
url="https://hubidubios.example"
license=('custom')
depends=('libxrender' 'libxtst' 'libxi' 'alsa-lib' 'fontconfig' 'freetype2' 'libglvnd')
optdepends=('libsecret: keep API keys in the system keyring (secret-tool)'
            'ufw: the package opens the phone-sync port to the LAN when ufw is on')
source=("hubidubios-linux-x64.tar.gz"
        "hubidubios.desktop"
        "hubidubios-firewall"
        "hubidubios-firewall.service")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')
options=('!strip' '!debug')

package() {
  install -d "$pkgdir/opt"
  cp -a "$srcdir/hubidubios" "$pkgdir/opt/hubidubios"
  install -d "$pkgdir/usr/bin"
  ln -s /opt/hubidubios/bin/HubidubiOS "$pkgdir/usr/bin/hubidubios"
  install -Dm644 "$srcdir/hubidubios.desktop" "$pkgdir/usr/share/applications/hubidubios.desktop"
  install -Dm644 "$srcdir/hubidubios/lib/HubidubiOS.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/hubidubios.png"

  # Phones sync with this computer on 5244. Omarchy's ufw denies incoming by
  # default; open only that port, only to private networks, at boot. A
  # package cannot run `systemctl enable`, so it ships the wants-symlink.
  install -Dm755 "$srcdir/hubidubios-firewall" "$pkgdir/usr/bin/hubidubios-firewall"
  install -Dm644 "$srcdir/hubidubios-firewall.service" \
    "$pkgdir/usr/lib/systemd/system/hubidubios-firewall.service"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -sf ../hubidubios-firewall.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/hubidubios-firewall.service"
}
