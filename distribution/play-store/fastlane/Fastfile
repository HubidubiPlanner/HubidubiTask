# Google Play release automation: `fastlane supply` uploads this folder's
# metadata and screenshots; the build lane makes the release.
#
# The signing key stays offline and out of the repo; losing it forces every
# user to uninstall and reinstall.

default_platform(:android)

platform :android do
  desc "Build the release APK"
  lane :build do
    # The Gradle build lives in src/apps/, away from the store listing.
    gradle(task: "assembleRelease", project_dir: File.expand_path("../../../src/apps", __dir__))
  end
end
