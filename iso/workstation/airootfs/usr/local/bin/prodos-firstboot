#!/usr/bin/env bash
# First-boot setup for a prodos workstation. Idempotent: safe to re-run.
# Creates the vault skeleton, installs the nftables/radicale/avahi configs
# shipped in the prodos-base package, and enables the per-user services.
set -euo pipefail

VAULT="${PRODOS_VAULT:-$HOME/vault}"
SEED=/usr/share/prodos/seed/vault

# On first run, seed the vault from the image (a starter vault + config baked
# in at build time). If there is no seed, just create the empty skeleton.
if [ ! -d "$VAULT" ] && [ -d "$SEED" ]; then
  mkdir -p "$VAULT"
  cp -a "$SEED/." "$VAULT/"
  echo "seeded vault from $SEED"
else
  mkdir -p "$VAULT"/{inbox,notes,tasks,calendars,projects,someday,.prodos}
fi

# Register the default plugin set's entity types FIRST (so the index below
# classifies the seeded files under the GTD types, not the builtin ones).
if command -v prodos-plugins >/dev/null 2>&1; then
  prodos-plugins refresh || true
fi

# Build the initial index.
prodos index rebuild || true

# Per-user services (sync + watcher + inference). System services (sshd,
# nftables, avahi) are enabled in the image.
systemctl --user enable --now prodos-sync.service 2>/dev/null || true
systemctl --user enable --now prodos-watch.service 2>/dev/null || true
systemctl --user enable --now vault-autocommit.timer 2>/dev/null || true
# selfhostedai-agent is the default inference server (local-only); llama.service is
# the fallback if selfhostedai-agent is not installed.
if command -v selfhostedai-agent >/dev/null 2>&1; then
  systemctl --user enable --now selfhostedai-agent.service 2>/dev/null || true
else
  systemctl --user enable --now llama.service 2>/dev/null || true
fi

# --- Desktop integration (Omarchy / Hyprland / Quickshell), no browser ---
# Wire the global capture keybind into the user's Hyprland config (idempotent).
HYPR="$HOME/.config/hypr/hyprland.conf"
if [ -f "$HYPR" ] && ! grep -q 'prodos-keybinds.conf' "$HYPR"; then
  echo 'source = /etc/prodos/hypr/prodos-keybinds.conf' >> "$HYPR"
fi

# Strip Omarchy Quattro's cloud coding-agent widget so nothing points at a
# cloud API. The nftables egress lockdown is the backstop regardless.
for cfg in "$HOME/.config/quickshell"/*/config.* ; do
  [ -f "$cfg" ] || continue
  sed -i '/claude-code/d; /coding-agent/d; /CodingAgent/d' "$cfg" 2>/dev/null || true
done
echo "prodos: add \`ProdosStatus {}\` (import \"/etc/prodos/quickshell\") to the bar."

echo "prodos workstation ready. Vault at $VAULT."
echo "Inference: $(prodos-agent status 2>/dev/null || echo 'configure [inference] in ~/vault/.prodos/config.toml')"
echo "Pair a phone with:  prodos-sync pair"
echo "Capture anywhere:   Super+Shift+Space"
