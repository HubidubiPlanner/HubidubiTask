# hubidubios-workstation package list (PLAN.md Phase 7).
# base + hubidubios-workstation metapackage + default plugins. The hubidubios-* packages
# come from the LAN repo declared in pacman.conf; build.sh builds them first.

# --- base live/install system (subset of releng essentials) ---
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
syslinux
edk2-shell
memtest86+-efi
intel-ucode
amd-ucode
sudo
nano
vim
openssh
git

# --- hubidubios ---
hubidubios-workstation
hubidubios-plugins-default

# hubidubios-workstation already pulls: hubidubios-base (hubidubios-vault, hubidubios-sync,
# nftables, avahi), hubidubios-plugin-host, hubidubios-agent, llama.cpp, radicale,
# syncthing, git. Listed here only for a legible manifest.
hubidubios-base
hubidubios-plugin-host
hubidubios-agent
radicale
syncthing
nftables
avahi
