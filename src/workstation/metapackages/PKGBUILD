# Maintainer: hubidubios
# Metapackages (PLAN.md Phase 3). Dependency-only; no payload.
pkgbase=hubidubios-meta
pkgname=('hubidubios-base' 'hubidubios-workstation' 'hubidubios-thin' 'hubidubios-plugins-default')
pkgver=0.1.0
pkgrel=1
arch=('any')
url="https://gitlab.local/hubidubios"
license=('MIT')

package_hubidubios-base() {
  pkgdesc="HubidubiOS base: vault CLI, sync, LAN discovery"
  # No firewall lockdown — HubidubiOS does not restrict the host's networking.
  depends=('hubidubios-vault' 'hubidubios-sync' 'avahi')
}

package_hubidubios-plugins-default() {
  pkgdesc="HubidubiOS default plugin set"
  # gtd supersedes the tasks + inbox extraction plugins (Phase 6).
  depends=('hubidubios-plugin-gtd' 'hubidubios-plugin-calendar')
}

package_hubidubios-workstation() {
  pkgdesc="HubidubiOS workstation layer for Omarchy: vault, agent, desktop integration"
  depends=('hubidubios-base' 'hubidubios-plugin-host' 'hubidubios-plugins-default'
           'hubidubios-agent' 'hubidubios-desktop' 'git')
  # Inference defaults to a remote selfhostedai endpoint, so a local model server is
  # optional; CalDAV/file-sync too. Keeps the install's dep closure lean + in the
  # offline mirror.
  optdepends=('llama.cpp: local OpenAI-compatible inference server'
              'radicale: local CalDAV server for calendars'
              'syncthing: desktop/laptop file sync')
}

package_hubidubios-thin() {
  pkgdesc="HubidubiOS thin client: no local state, no local inference"
  depends=('openssh' 'mosh' 'tmux')
}
