# Maintainer: hubidubios
pkgname=hubidubios-vault
pkgver=0.1.0
pkgrel=1
pkgdesc="hubidubios vault core: entities, indexer, CLI (files are the source of truth)"
arch=('any')
url="https://gitlab.local/hubidubios"
license=('MIT')
depends=('python' 'python-watchdog' 'python-yaml' 'python-icalendar')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
source=()

build() {
  cd "$startdir"
  python -m build --wheel --no-isolation
}

package() {
  cd "$startdir"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
