# Maintainer: hubidubios
pkgname=hubidubios-plugin-host
pkgver=0.1.0
pkgrel=1
pkgdesc="hubidubios plugin loader, skill sandbox (bwrap), and view bridge"
arch=('any')
url="https://gitlab.local/hubidubios"
license=('MIT')
depends=('python' 'hubidubios-vault' 'python-yaml' 'python-jsonschema' 'bubblewrap')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
source=()

build() {
  cd "$startdir"
  python -m build --wheel --no-isolation
}

package() {
  cd "$startdir"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
