[Unit]
Description=Open the HubidubiOS harness port to the LAN (ufw)
Documentation=man:ufw(8)
# ufw.service sets the policy we are adding a rule to; ordering after it keeps
# our allow rule from being applied to a firewall that is about to be reloaded.
After=ufw.service network-online.target
Wants=network-online.target
ConditionPathExists=/usr/bin/ufw

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/hubidubios-harness-firewall

[Install]
WantedBy=multi-user.target
