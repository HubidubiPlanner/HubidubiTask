# User unit. Log in to Claude Code once as this user (run `claude`), then
#   systemctl --user enable --now hubidubios-harness
#   hubidubios-harness show      # what to type into the apps
[Unit]
Description=Claude Code served to the HubidubiOS apps
After=network-online.target

[Service]
ExecStart=/usr/bin/hubidubios-harness serve --bind auto
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
