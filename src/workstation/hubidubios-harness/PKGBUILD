# Maintainer: hubidubios
pkgname=hubidubios-harness
pkgver=0.1.0
pkgrel=1
pkgdesc="Claude Code on the workstation, served to the HubidubiOS phone and Mac apps"
arch=('any')
url="https://gitlab.local/hubidubios"
license=('MIT')
# Claude Code itself is installed by its own installer (it is not a pacman
# package); the service reports plainly when it is missing.
depends=('python' 'openssl')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
source=()

build() {
  cd "$startdir"
  python -m build --wheel --no-isolation
}

package() {
  cd "$startdir"
  python -m installer --destdir="$pkgdir" dist/*.whl

  # The user unit is not enabled for anyone: it needs that user's Claude Code
  # login first. `systemctl --user enable --now hubidubios-harness` after it.
  install -Dm644 "$startdir/systemd/hubidubios-harness.service" \
    "$pkgdir/usr/lib/systemd/user/hubidubios-harness.service"

  # Omarchy's ufw denies incoming by default; open only our port, only to the LAN.
  install -Dm755 "$startdir/bin/hubidubios-harness-firewall" \
    "$pkgdir/usr/bin/hubidubios-harness-firewall"
  install -Dm644 "$startdir/systemd/hubidubios-harness-firewall.service" \
    "$pkgdir/usr/lib/systemd/system/hubidubios-harness-firewall.service"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -sf ../hubidubios-harness-firewall.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/hubidubios-harness-firewall.service"
}
