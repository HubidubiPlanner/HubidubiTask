# User unit: install to ~/.config/systemd/user/, then
#   systemctl --user enable --now hubidubios-gcal.timer
# Pulls the configured calendars shortly after login and every 15 minutes.

[Unit]
Description=Pull Google/iCal calendars into the vault periodically

[Timer]
OnStartupSec=2min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
