#!/usr/bin/env bash
# First-boot setup for a hubidubios workstation. Idempotent: safe to re-run.
# Creates the vault skeleton, seeds/migrates it, and enables the per-user
# services. Runs automatically once on first login via the user service
# hubidubios-firstboot.service (guarded by the stamp dropped at the end).
set -euo pipefail

VAULT="${HUBIDUBIOS_VAULT:-$HOME/vault}"
SEED=/usr/share/hubidubios/seed/vault

# On first run, seed the vault from the image (a starter vault + config baked
# in at build time). If there is no seed, just create the empty skeleton.
if [ ! -d "$VAULT" ] && [ -d "$SEED" ]; then
  mkdir -p "$VAULT"
  cp -a "$SEED/." "$VAULT/"
  echo "seeded vault from $SEED"
else
  mkdir -p "$VAULT"/{inbox,notes,tasks,calendars,projects,someday,.hubidubios}
fi

# Register the default plugin set's entity types FIRST (so the index below
# classifies the seeded files under the GTD types, not the builtin ones).
if command -v hubidubios-plugins >/dev/null 2>&1; then
  hubidubios-plugins refresh || true
fi

# Upgrade a pre-Phase-9 vault (tasks/, tasks/waiting.md, someday/) to the
# current/waiting/maybe layout. Idempotent + a no-op on a fresh seeded vault.
hubidubios migrate-layout || true

# Build the initial index.
hubidubios index rebuild || true

# Per-user services (sync + watcher + inference). System services (sshd,
# avahi) are enabled in the image.
systemctl --user enable --now hubidubios-sync.service 2>/dev/null || true
systemctl --user enable --now hubidubios-watch.service 2>/dev/null || true
systemctl --user enable --now vault-autocommit.timer 2>/dev/null || true
# Google/iCal calendar pull — a no-op until [calendar] URLs are configured.
systemctl --user enable --now hubidubios-gcal.timer 2>/dev/null || true
# selfhostedai-agent is the default inference server (local-only); llama.service is
# the fallback if selfhostedai-agent is not installed.
if command -v selfhostedai-agent >/dev/null 2>&1; then
  systemctl --user enable --now selfhostedai-agent.service 2>/dev/null || true
else
  systemctl --user enable --now llama.service 2>/dev/null || true
fi

# --- Desktop integration (Omarchy / Hyprland / Quickshell) — ADDITIVE ONLY ---
# HubidubiOS is a pure addition on top of stock Omarchy: we only APPEND our
# keybind source line; we never edit or remove any Omarchy config or widget.
HYPR="$HOME/.config/hypr/hyprland.conf"
if [ -f "$HYPR" ] && ! grep -q 'hubidubios-keybinds.conf' "$HYPR"; then
  echo 'source = /etc/hubidubios/hypr/hubidubios-keybinds.conf' >> "$HYPR"
fi
echo "HubidubiOS: add \`HubidubiOsStatus {}\` (import \"/etc/hubidubios/quickshell\") to your bar."

echo "HubidubiOS workstation ready. Vault at $VAULT."
echo "Inference: $(hubidubios-agent status 2>/dev/null || echo 'configure [inference] in ~/vault/.hubidubios/config.toml')"
echo "Pair a phone with:  hubidubios-sync pair"
echo "Capture anywhere:   Super+Shift+Space"

# Drop the completion stamp so the auto-run user service
# (hubidubios-firstboot.service) skips subsequent logins. Manual re-runs still
# work — this stamp only gates the automatic first-login trigger.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hubidubios"
mkdir -p "$STATE_DIR"
: > "$STATE_DIR/firstboot-done"
