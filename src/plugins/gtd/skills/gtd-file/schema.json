{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["inbox_id", "kind"],
  "additionalProperties": false,
  "properties": {
    "inbox_id": {"type": "string", "pattern": "^i_[a-z2-7]+$"},
    "kind": {"enum": ["next_action", "project", "waiting_for", "someday", "trash"]},
    "text": {"type": "string", "description": "action/outcome text; defaults to the inbox text"},
    "project": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "context": {"type": "string", "pattern": "^@[a-z/-]+$"},
    "due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "who": {"type": "string"},
    "time": {"type": "integer", "minimum": 1},
    "energy": {"type": "string", "enum": ["low", "med", "high"]}
  }
}
