# Maintainer: hubidubios
pkgname=hubidubios-plugin-calendar
pkgver=1.0.0
pkgrel=1
pkgdesc="HubidubiOS plugin: iCalendar events, shared with Radicale"
arch=('any')
url="https://gitlab.local/hubidubios"
license=('MIT')
depends=('hubidubios-plugin-host')
install=hubidubios-plugin.install
source=()

package() {
  local dest="$pkgdir/usr/share/hubidubios/plugins/calendar"
  local src="$startdir"
  install -d "$dest"
  cp -r "$src/PLUGIN.md" "$src/entities" "$src/skills" "$dest/"
  chmod 755 "$dest"/skills/*/bin/run
}
