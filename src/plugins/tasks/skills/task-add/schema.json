{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["text"],
  "additionalProperties": false,
  "properties": {
    "text": {"type": "string", "minLength": 1, "description": "The task, one physical action"},
    "project": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "Project name; defaults to inbox"},
    "due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Due date YYYY-MM-DD"},
    "ctx": {"type": "string", "pattern": "^@[a-z/-]+$", "description": "Context tag, e.g. @computer"}
  }
}
