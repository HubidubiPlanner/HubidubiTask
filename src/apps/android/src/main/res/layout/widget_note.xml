<?xml version="1.0" encoding="utf-8"?>
<!-- One cell, drawn like a launcher icon beside the others: the icon, its name under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_note"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@string/note_widget_label"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_note_round" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="@string/note_widget_label"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</LinearLayout>
