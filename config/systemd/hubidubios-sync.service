# User unit: install to ~/.config/systemd/user/, then
#   systemctl --user enable --now hubidubios-sync
# 'auto' binds the primary LAN IP (never 0.0.0.0); set a fixed address here if
# the host has several interfaces and you want a specific one.

[Unit]
Description=hubidubios change-feed API
After=network-online.target

[Service]
ExecStart=/usr/bin/hubidubios-sync serve --bind auto
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
