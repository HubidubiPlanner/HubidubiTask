# macOS folder metadata
.DS_Store

# Gradle, Kotlin and IDE output (src/apps keeps its own .gitignore too)
build/
.gradle/
.kotlin/


# The app package distribution/arch/build.sh makes
distribution/arch/out/
# ...and the AppImage distribution/appimage/build.sh makes
distribution/appimage/out/
*.pkg.tar.zst

# Python caches
__pycache__/
*.pyc

# Keys and secrets never belong here (release keys live in ~/.keystores and ~/.ssh)
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
id_rsa*
id_ed25519*
*_ed25519
.env
.env.*
local.properties

# Claude Code agent worktrees
.claude/worktrees/
