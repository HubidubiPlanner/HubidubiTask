{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "prodos plugin manifest (PLUGIN.md frontmatter)",
  "type": "object",
  "required": ["name", "version", "description", "api"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1},
    "api": {"type": "integer", "minimum": 1},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "schema", "path"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "schema": {"type": "string"},
          "path": {"type": "string", "pattern": "^[a-z][a-z0-9_/-]*/$"},
          "suffix": {"type": "string", "pattern": "^\\.[a-z0-9]+$", "default": ".md"}
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sandbox"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "sandbox": {
            "type": "object",
            "required": ["read", "write", "network", "timeout"],
            "additionalProperties": false,
            "properties": {
              "read": {"type": "array", "items": {"type": "string", "pattern": "^vault:[a-z][a-z0-9_/-]*$"}},
              "write": {"type": "array", "items": {"type": "string", "pattern": "^vault:[a-z][a-z0-9_/-]*$"}},
              "network": {"enum": ["none", "lan"]},
              "timeout": {"type": "string", "pattern": "^[0-9]+s$"}
            }
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "permissions"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "title": {"type": "string"},
          "icon": {"type": "string"},
          "permissions": {
            "type": "object",
            "required": ["read"],
            "additionalProperties": false,
            "properties": {
              "read": {"type": "array", "items": {"type": "string"}},
              "write": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "cli": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    }
  }
}
