#!/usr/bin/env bash
# Native next-actions panel for the Omarchy desktop (Phase 8). Reads the ranked
# next actions as JSON and shows them in a native menu; selecting one marks it
# done. No browser, no WebView.
set -euo pipefail

json="$(hubidubios-plugins run-skill gtd gtd-next '{}' 2>/dev/null || echo '{}')"
# id \t label lines, using jq if present, else a python fallback (always on the image).
lines="$(printf '%s' "$json" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
for a in d.get("actions", []):
    ctx = a.get("context") or ""
    label = (ctx + " " + (a.get("text") or "")).strip()
    print(a.get("id", "") + "\t" + label)
')"

[ -z "$lines" ] && { command -v notify-send >/dev/null && notify-send "hubidubios" "No next actions"; exit 0; }

menu() { if command -v fuzzel >/dev/null; then fuzzel --dmenu; else wofi --dmenu; fi; }
choice="$(printf '%s\n' "$lines" | cut -f2- | menu || true)"
[ -z "$choice" ] && exit 0

id="$(printf '%s\n' "$lines" | awk -F'\t' -v c="$choice" '$2==c{print $1; exit}')"
[ -n "$id" ] && hubidubios task done "$id" 2>/dev/null && \
  { command -v notify-send >/dev/null && notify-send "hubidubios" "Done: $choice"; }
