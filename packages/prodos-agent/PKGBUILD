# Maintainer: prodos
pkgname=prodos-agent
pkgver=0.1.0
pkgrel=1
pkgdesc="prodos agent: constrained skill-dispatch loop over a local llama.cpp endpoint"
arch=('any')
url="https://gitlab.local/prodos"
license=('MIT')
depends=('python' 'prodos-vault' 'prodos-plugin-host' 'python-jsonschema')
optdepends=('llama.cpp: local inference server on :8080')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
source=()

build() {
  cd "$startdir"
  python -m build --wheel --no-isolation
}

package() {
  cd "$startdir"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
