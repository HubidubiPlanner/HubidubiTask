# Maintainer: hubidubios
pkgname=hubidubios-sync
pkgver=0.1.0
pkgrel=1
pkgdesc="hubidubios change-feed API: entity-level sync over pinned TLS on the LAN"
arch=('any')
url="https://gitlab.local/hubidubios"
license=('MIT')
depends=('python' 'hubidubios-vault' 'openssl' 'python-qrcode')
optdepends=('hubidubios-agent: enables the /v1/agent/ask proxy')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel')
source=()

build() {
  cd "$startdir"
  python -m build --wheel --no-isolation
}

package() {
  cd "$startdir"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
