#!/usr/bin/env bash
# Rebuild and install the HubidubiOS workstation packages from this checkout,
# then restart what runs from them.
#
# Run it on the workstation:
#     ./deploy/workstation/hubidubios-update
#
# Everything here is Python, so a build is quick. The packages are installed
# with pacman rather than pip: the workstation's files belong to a package
# manager, and half-pip-half-pacman is how a system stops being reproducible.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# Order matters: the later packages depend on the earlier ones.
PACKAGES=(hubidubios-vault hubidubios-plugin-host hubidubios-agent
          hubidubios-sync hubidubios-desktop)
BUILD="$(mktemp -d)"
trap 'rm -rf "$BUILD"' EXIT

if ! command -v makepkg >/dev/null; then
  echo "makepkg not found — this script installs Arch packages and must run on"
  echo "the HubidubiOS workstation, not on the machine you edit from." >&2
  exit 1
fi

echo "==> building from $REPO"
built=()
for pkg in "${PACKAGES[@]}"; do
  src="$REPO/src/workstation/$pkg"
  [ -d "$src" ] || { echo "    skip $pkg (not in this checkout)"; continue; }
  # Build in a copy: makepkg writes pkg/, src/ and dist/ next to the PKGBUILD,
  # and the checkout is not the place for build droppings.
  cp -r "$src" "$BUILD/$pkg"
  ( cd "$BUILD/$pkg" && makepkg -f --nodeps --skipinteg >/dev/null )
  out=("$BUILD/$pkg"/*.pkg.tar.zst)
  echo "    built $(basename "${out[0]}")"
  built+=("${out[0]}")
done

[ ${#built[@]} -gt 0 ] || { echo "nothing to install" >&2; exit 1; }

echo "==> installing (sudo)"
sudo pacman -U --noconfirm "${built[@]}"

echo "==> restarting services"
for unit in hubidubios-sync hubidubios-watch; do
  if systemctl --user list-unit-files "$unit.service" >/dev/null 2>&1; then
    systemctl --user restart "$unit" 2>/dev/null \
      && echo "    restarted $unit" \
      || echo "    $unit not running; start it with: systemctl --user start $unit"
  fi
done

echo "==> what is installed now"
python - <<'PY'
import importlib.metadata as md
for dist in ("hubidubios-vault", "hubidubios-agent", "hubidubios-sync",
             "hubidubios-plugin-host"):
    try:
        print(f"    {dist} {md.version(dist)}")
    except md.PackageNotFoundError:
        print(f"    {dist} NOT INSTALLED")
PY

cat <<'EOF'

Done. To watch it work:
    journalctl --user -u hubidubios-sync -f
    tail -f ~/.local/state/hubidubios/agent.log
EOF
