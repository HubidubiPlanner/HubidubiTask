# llama.cpp OpenAI-compatible server (PLAN.md Phase 4).
# Model preloaded and resident. Start with a 30B-class Q4 for latency;
# evaluate 70B for quality. ROCm and Vulkan backends differ significantly on
# the integrated GPU — benchmark both, set the binary/flags accordingly.
#
# Bind loopback only: the agent daemon proxies; the LAN reaches inference via
# hubidubios-sync, not this port directly. (nftables allows :8080 from the LAN for
# power users, but the default is host-local.)

[Unit]
Description=llama.cpp inference server
After=network-online.target

[Service]
ExecStart=/usr/bin/llama-server \
  --model %h/models/model.gguf \
  --host 127.0.0.1 --port 8080 \
  --ctx-size 8192 --parallel 1 \
  --mlock
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
