# Radicale for third-party desktop CalDAV clients (PLAN.md Phase 2).
# The phone app never uses this; it talks to hubidubios-sync.
# Install to /etc/radicale/config.
#
# Storage shares the vault's calendars directory with no bridge layer:
#   mkdir -p ~/.local/state/radicale/collection-root
#   ln -s ~/vault/calendars ~/.local/state/radicale/collection-root/<user>
# The vault indexer already ignores dotfiles, so .Radicale.props and
# .Radicale.cache in calendars/ are invisible to it.

[server]
# Bind the LAN interface explicitly. Never 0.0.0.0.
hosts = 192.168.1.60:5232
ssl = True
certificate = /etc/radicale/cert.pem
key = /etc/radicale/key.pem

[auth]
type = htpasswd
htpasswd_filename = /etc/radicale/users
htpasswd_encryption = bcrypt

[storage]
filesystem_folder = ~/.local/state/radicale

[rights]
type = owner_only
