# The website's public address and contact email. The site, its privacy
# policy and the Google Play listing (deploy/google-play, steps 2 and 4) all
# use these.
SITE_URL=https://hubidubitask.github.io/HubidubiTask
CONTACT_EMAIL=hubidubiplanner@hubidubitask.invalid

# Where the Mac and Linux downloads are served from. Empty: from the
# website itself, under /downloads/. Set it when the web host cannot take
# files of 150 MB (see ../3-publish/README.md), e.g.
# DOWNLOADS_URL=https://files.example.com/hubidubitask
DOWNLOADS_URL=

# Where 3-publish/publish.sh uploads the assembled site with rsync, e.g.
# PUBLISH_TARGET=me@myserver:/var/www/hubidubitask/
PUBLISH_TARGET=
